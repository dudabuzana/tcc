// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["interactiveTransactions"]
  binaryTargets   = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UsuarioNivel {
  instituicao
  professor
  aluno
}

model Usuario {
  cpfCnpj String  @id @db.VarChar(16)
  token   String? @unique
  senha   String
  nivel   UsuarioNivel

  instituicao Instituicao?
  pessoa      Pessoa?

  @@map("usuario")
}

model Instituicao {
  cpfCnpj  String @id @db.VarChar(16)
  nome     String
  endereco String
  contato  String

  Usuario Usuario? @relation(fields: [cpfCnpj], references: [cpfCnpj], onDelete: Cascade)

  professor  Pessoa[]
  disciplina Disciplina[]

  @@map("instituicao")
}

model Pessoa {
  cpfCnpj            String @id @db.VarChar(16)
  cpfCnpjInstituicao String @db.VarChar(16)
  nome               String
  matricula          String @unique

  Usuario     Usuario?     @relation(fields: [cpfCnpj], references: [cpfCnpj], onDelete: Cascade)
  Instituicao Instituicao? @relation(fields: [cpfCnpjInstituicao], references: [cpfCnpj])

  turma Turma[] //Professor
  alunoTurma AlunoTurma[] //Aluno
  resposta Resposta[] //Aluno

  @@map("pessoa")
}

model Disciplina {
  id      String @id @default(uuid())
  cpfCnpj String @db.VarChar(16)
  nome    String 
  curso   String

  Instituicao Instituicao? @relation(fields: [cpfCnpj], references: [cpfCnpj])

  turma Turma[]

  @@map("disciplina")
}

model Turma {
  id           String @id @default(uuid())
  idDisciplina String
  cpfCnpj      String @db.VarChar(16)
  semestre     Int

  Pessoa     Pessoa?     @relation(fields: [cpfCnpj], references: [cpfCnpj])
  Disciplina Disciplina? @relation(fields: [idDisciplina], references: [id])

  alunoTurma AlunoTurma[]
  formulario Formulario[]

  @@map("turma")
}

model AlunoTurma {
  id      String
  cpfCnpj String @db.VarChar(16)

  Turma  Turma?  @relation(fields: [id], references: [id])
  Pessoa Pessoa? @relation(fields: [cpfCnpj], references: [cpfCnpj])

  @@id([id, cpfCnpj])

  @@unique(fields: [id, cpfCnpj], name: "idCpfCnpj")

  @@map("aluno_turma")
}

model Formulario {
  id          String @id @default(uuid())
  idTurma     String
  status      String
  dataCriacao DateTime @default(now())

  Turma  Turma?  @relation(fields: [idTurma], references: [id])

  perguntaFormulario PerguntaFormulario[]

  @@map("formulario")
}

enum PerguntaTipo {
  likert
  descritivo
}

model PerguntaFormulario {
  id           Int @default(autoincrement())
  idFormulario String
  titulo       String
  descricao    String
  tipo         PerguntaTipo

  @@id([id, idFormulario])

  Formulario Formulario? @relation(fields: [idFormulario], references: [id], onDelete: Cascade)

  resposta Resposta[]

  @@map("pergunta_formulario")
}

model Resposta {
  idPergunta   Int
  idFormulario String
  cpfCnpj      String
  resposta     String

  @@id([idPergunta, idFormulario, cpfCnpj])

  PerguntaFormulario PerguntaFormulario? @relation(fields: [idPergunta, idFormulario], references: [id, idFormulario])
  Pessoa Pessoa? @relation(fields: [cpfCnpj], references: [cpfCnpj])

  @@map("resposta")
}